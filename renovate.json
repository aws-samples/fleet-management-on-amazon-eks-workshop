{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["gitops/addons/charts/gitops-bridge/values\\.yaml$"],
      "matchStrings": [
        "chart: (?<depName>[^\\s]+)\\s+repoUrl: (?:[^\\s]+)\\s+targetRevision: \"?(?<currentValue>[0-9][0-9\\.]+)\"?"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "{{#if registryUrl}}{{registryUrl}}{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "hostRules": [
    {
      "matchHost": "public.ecr.aws",
      "hostType": "docker"
    },
    {
      "matchHost": "ghcr.io",
      "hostType": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^argo-cd$"],
      "registryUrls": ["https://argoproj.github.io/argo-helm"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-load-balancer-controller$", "^aws-cloudwatch-metrics$", "^aws-for-fluent-bit$", "^cni-metrics-helper$", "^aws-node-termination-handler$"],
      "registryUrls": ["https://aws.github.io/eks-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^gatekeeper$"],
      "registryUrls": ["https://open-policy-agent.github.io/gatekeeper/charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^metrics-server$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/metrics-server"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-ebs-csi-classes$", "^aws-fargate-fluentbit$", "^crossplane-aws$", "^crossplane-aws-upbound$", "^crossplane-helm$", "^crossplane-kubernetes$"],
      "registryUrls": ["https://gitops-bridge-dev.github.io/gitops-bridge-helm-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^karpenter$", "^karpenter/karpenter$"],
      "registryUrls": ["https://charts.karpenter.sh"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-gateway-controller-chart$"],
      "registryUrls": ["https://aws.github.io/aws-application-networking-k8s"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^volcano$"],
      "registryUrls": ["https://volcano-sh.github.io/helm-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-efs-csi-driver$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/aws-efs-csi-driver"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-fsx-csi-driver$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/aws-fsx-csi-driver"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^argo-workflows$", "^argo-events$", "^argo-rollouts$"],
      "registryUrls": ["https://argoproj.github.io/argo-helm"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^cluster-autoscaler$"],
      "registryUrls": ["https://kubernetes.github.io/autoscaler"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^external-dns$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/external-dns"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^external-secrets$"],
      "registryUrls": ["https://charts.external-secrets.io"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^velero$"],
      "registryUrls": ["https://vmware-tanzu.github.io/helm-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^secrets-store-csi-driver-provider-aws$"],
      "registryUrls": ["https://aws.github.io/secrets-store-csi-driver-provider-aws"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^cluster-proportional-autoscaler$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/cluster-proportional-autoscaler"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^crossplane$"],
      "registryUrls": ["https://charts.crossplane.io/stable"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^gpu-operator$"],
      "registryUrls": ["https://nvidia.github.io/gpu-operator"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^ingress-nginx$"],
      "registryUrls": ["https://kubernetes.github.io/ingress-nginx"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^keda$"],
      "registryUrls": ["https://kedacore.github.io/charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^kube-prometheus-stack$", "^prometheus-adapter$", "^kube-state-metrics$", "^prometheus-node-exporter$"],
      "registryUrls": ["https://prometheus-community.github.io/helm-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^opentelemetry-operator$"],
      "registryUrls": ["https://open-telemetry.github.io/opentelemetry-helm-charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^kyverno$", "^kyverno-policies$"],
      "registryUrls": ["https://kyverno.github.io/kyverno"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^policy-reporter$"],
      "registryUrls": ["https://kyverno.github.io/policy-reporter"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^secrets-store-csi-driver$"],
      "registryUrls": ["https://kubernetes-sigs.github.io/secrets-store-csi-driver/charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^vpa$"],
      "registryUrls": ["https://charts.fairwinds.com/stable"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-controllers-k8s/.*$"],
      "registryUrls": ["https://aws-controllers-k8s.github.io/charts"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^grafana/helm-charts/grafana-operator$"],
      "enabled": false
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^kro-run/kro/kro$"],
      "enabled": false
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^cert-manager$"],
      "registryUrls": ["https://charts.jetstack.io"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackagePatterns": ["^aws-privateca-issuer$"],
      "registryUrls": ["https://cert-manager.github.io/aws-privateca-issuer"]
    }
  ]
}
